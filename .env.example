# ─── EstateFlow CRM environment ──────────────────────────────────────────────
# Copy to .env.local for local dev. Every provider credential is OPTIONAL:
# missing creds degrade the matching adapter to dry-run (simulated) mode.

# ── Supabase (required to run the app) ───────────────────────────────────────
# Local stack: `supabase start` prints these. Hosted: Project Settings → API.
# Either key name works — new projects issue sb_publishable_… keys:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=…  or  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=…
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER exposed to the browser. Used for webhooks, system
# notifications, integration settings and the seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────────────────────────
# true (default) = every adapter simulates; no external calls are placed.
# Set to false only when live provider credentials are configured.
DRY_RUN=true

# Absolute base URL (share links, Twilio webhooks). Use your Vercel URL in prod.
APP_URL=http://localhost:3000

# 32-byte base64 key for encrypting per-org secrets in integration_settings.
# Generate: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

# Protects /api/cron/* (follow-up due reminders). Vercel Cron sends it
# automatically as "Authorization: Bearer <value>" when set.
CRON_SECRET=

# ── Twilio (voice bridge + SMS/WhatsApp) — optional env fallback ─────────────
# Per-org values in Settings → Integrations take precedence.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# WhatsApp-enabled sender (E.164, without the whatsapp: prefix)
WHATSAPP_SENDER=

# ── Email (Resend) — optional ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Sunrise Realty <hello@example.com>"

# ── AI caption generation (OpenAI-compatible) — optional ─────────────────────
AI_API_KEY=
AI_BASE_URL=

# ── Seed script ──────────────────────────────────────────────────────────────
# Password assigned to all demo users (default: EstateFlow!Demo1)
SEED_PASSWORD=
